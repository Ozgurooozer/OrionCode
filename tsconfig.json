{
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "include": [
    "*.ts",
    "core/**/*.ts",
    "backends/**/*.ts",
    "tools/**/*.ts",
    "tui/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "graphify-out",
    "electron",
    "tests",
    "scripts",
    "tui/beta2",
    "tui/beta3",
    "orion-server.ts"
  ]
}
