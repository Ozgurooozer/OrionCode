# Kimlik bilgileri — ASLA commit edilmez
credentials.json

# Bağımlılıklar
node_modules/

# Electron derleme çıktıları
electron/dist/
electron/release/

# graphify analiz çıktıları
graphify-out/

# CodeGraph index (yeniden oluşturulabilir)
.codegraph/

# Orion server çalışma zamanı state
.orion-server-run.ts

# Çalışma zamanı çıktıları
logs/
*.log

# Claude Code yerel config
.claude/

# MCP config (makine-spesifik absolute path içerir, .example'dan üret)
.mcp.json
mcp.json

# Ortam değişkenleri
.env
.env.local

# Test çıktıları (binary terminal verisi içerebilir)
*-test-output.txt

# promptfoo çıktıları
.promptfoo/
promptfoo-cache/

# Harici git repo (Kitty terminal — sadece geliştirme için clone)
kitty/

# TUI prototipleri (izole sub-projeler, ana projeye bağlı değil)
tui/beta2/
tui/beta3/

# 3D animasyon sub-projesi — bağımlılıklar ve derleme çıktısı
tui/animation/node_modules/
tui/animation/bundle/

# Arşiv prototip — minified bundle'lar (beta3 babylon.js ~5MB)
tui/arcive/beta3/bundle/

# ComfyUI kurulumu, modeller, venv — repo dışı olması gereken ağır dosyalar (~82GB)
3d/ComfyUI/
3d/MODELLER/
3d/venv/
3d/COMFYUI_USER/

# Python cache
__pycache__/
*.pyc

# Eval çıktıları (geçici, yeniden üretilebilir)
eval-results.json
eval-results2.json
eval-debug2.txt

# TAYF kanal çalışma zamanı state (pid, canlı jsonl akışı)
TAYF/.tayf/
TAYF/.tayfkanal.jsonl
