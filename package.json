{
  "name": "molp",
  "version": "1.0.0",
  "description": "BYOK CLI kodlama ajanı — yerel (Ollama) ve bulut modelleri, MCP ve kalıcı vault hafızasını tek çekirdekte birleştiren araştırma projesi.",
  "main": "orion.js",
  "bin": {
    "orion": "./orion.js"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"tests/**/*.test.js\"",
    "start": "node --experimental-strip-types orion.js",
    "server": "node orion-server.js",
    "bench": "node scripts/bench.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "byok",
    "mcp",
    "ollama",
    "anthropic"
  ],
  "author": "Ozyn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ozgurooozer/OrionCode.git"
  },
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^4.1.2",
    "commander": "^15.0.0",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
