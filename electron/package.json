{
  "name": "orion-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Orion Aethelred — CLI kullanmak istemeyenler için masaüstü (Electron) istemcisi. orion-server.js'e HTTP+SSE ile bağlanır, CLI ile aynı core/ mantığını paylaşır.",
  "main": "main.js",
  "scripts": {
    "build:renderer": "node build.js",
    "dev": "node build.js --watch & electron . ",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "author": "Ozyn",
  "license": "MIT",
  "dependencies": {
    "@babylonjs/core": "^9.17.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.ozyn.orion-desktop",
    "productName": "Orion",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "dist/**",
      "assets/**"
    ],
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.1": true
  }
}
